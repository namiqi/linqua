# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev bypass — create a UUID for your personal account (any valid UUID)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional: protect dev bypass on public deploy
# DEV_BYPASS_SECRET=your-secret-here

# Optional: for AI story generation (falls back to template without this)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Netlify: add the variables above in Site settings → Environment variables
# (SUPABASE_SERVICE_ROLE_KEY and DEV_BYPASS_SECRET must NOT be exposed to the browser)
