# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev bypass — create a UUID for your personal account (any valid UUID)
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional: protect dev bypass on public deploy
# DEV_BYPASS_SECRET=your-secret-here

# Optional: for AI story generation via Google Gemini (falls back to template without this)
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash-lite

# Netlify: add the variables above in Site settings → Environment variables
# (SUPABASE_SERVICE_ROLE_KEY and DEV_BYPASS_SECRET must NOT be exposed to the browser)
